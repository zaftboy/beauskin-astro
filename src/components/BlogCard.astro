---
interface Props {
  title: string;
  slug: string;
  date: string;
  category: string;
  excerpt: string;
}

const { title, slug, date, category, excerpt } = Astro.props;

const categoryStyles: Record<string, string> = {
  '護膚技巧': 'bg-sage-50 text-sage-600',
  '成分解析': 'bg-brand-50 text-brand-600',
  '彩妝教學': 'bg-rose-50 text-rose-600',
  '防曬知識': 'bg-amber-50 text-amber-600',
};

const tagStyle = categoryStyles[category] ?? 'bg-gray-50 text-gray-600';
---

<article class="bg-white rounded-2xl overflow-hidden border border-gray-100 p-6 hover:shadow-lg transition-shadow">
  <div class="flex items-center gap-3 mb-3">
    <span class:list={['px-3 py-1 rounded-full text-xs', tagStyle]}>{category}</span>
    <time class="text-sm text-gray-400">{date}</time>
  </div>
  <h3 class="font-serif text-xl text-brand-800 mt-1">
    <a href={`/blog/${slug}`} class="hover:text-brand-600 transition-colors">{title}</a>
  </h3>
  <p class="text-gray-500 text-sm mt-2 line-clamp-3">{excerpt}</p>
  <a href={`/blog/${slug}`} class="inline-block text-brand-600 text-sm font-medium hover:text-brand-800 transition-colors mt-4">
    閱讀全文 &rarr;
  </a>
</article>
