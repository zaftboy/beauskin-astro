---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const navLinks = [
  { label: '首頁', href: '/' },
  { label: '全部產品', href: '/products' },
  { label: '美妝知識', href: '/blog' },
  { label: '關於我們', href: '/about' },
  { label: '聯繫我們', href: '/contact' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="fixed top-0 left-0 right-0 bg-white/90 backdrop-blur-md border-b border-gray-100 z-50 h-16">
  <nav class="max-w-6xl mx-auto px-4 h-full flex justify-between items-center">
    <!-- Logo -->
    <a href="/" class="flex flex-col leading-tight">
      <span class="font-serif text-brand-700 text-xl tracking-widest">綻顏</span>
      <span class="text-brand-400 text-xs tracking-[0.2em]">BEAUSKIN</span>
    </a>

    <!-- Desktop Nav -->
    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class:list={[
              'nav-link text-sm transition-colors',
              isActive(link.href)
                ? 'text-brand-700 font-medium'
                : 'text-gray-600 hover:text-brand-700',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile Hamburger -->
    <button
      id="menuToggle"
      class="md:hidden flex flex-col justify-center items-center gap-1.5 w-8 h-8"
      aria-label="選單"
    >
      <span class="block w-5 h-0.5 bg-gray-700 transition-transform" id="bar1"></span>
      <span class="block w-5 h-0.5 bg-gray-700 transition-opacity" id="bar2"></span>
      <span class="block w-5 h-0.5 bg-gray-700 transition-transform" id="bar3"></span>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobileMenu" class="hidden absolute top-16 left-0 right-0 bg-white shadow-lg md:hidden">
    <ul class="flex flex-col py-4">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class:list={[
              'block px-6 py-3 text-sm transition-colors',
              isActive(link.href)
                ? 'text-brand-700 font-medium bg-brand-50'
                : 'text-gray-600 hover:text-brand-700 hover:bg-gray-50',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menuToggle');
  const menu = document.getElementById('mobileMenu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
