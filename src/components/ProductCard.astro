---
interface Props {
  name: string;
  slug: string;
  price: number;
  shortDesc: string;
  image: string;
  tags?: string[];
}

const { name, slug, price, shortDesc, image, tags = [] } = Astro.props;
---

<article class="product-card bg-white rounded-2xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-lg transition-shadow">
  <a href={`/products/${slug}`} class="block">
    <div class="w-full aspect-[4/5] overflow-hidden bg-brand-50">
      <img src={image} alt={name} class="w-full h-full object-cover" loading="lazy" />
    </div>
  </a>
  <div class="p-5">
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-3">
        {tags.map(tag => (
          <span class="px-3 py-1 rounded-full text-xs bg-sage-50 text-sage-600">{tag}</span>
        ))}
      </div>
    )}
    <h3 class="font-serif text-lg text-brand-800">
      <a href={`/products/${slug}`} class="hover:text-brand-600 transition-colors">{name}</a>
    </h3>
    <p class="text-gray-500 text-sm mt-2 line-clamp-2">{shortDesc}</p>
    <p class="text-brand-700 font-medium mt-3">HK${" "}{price.toFixed(2)}</p>
  </div>
</article>
