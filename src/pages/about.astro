---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBanner from '../components/HeroBanner.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<BaseLayout
  title="關於我們 — 綻顏 BEAUSKIN"
  description="認識綻顏 BEAUSKIN — 一個為香港女性而生的護膚品牌。了解我們的品牌故事、價值觀及發展歷程。"
>

  <!-- Hero Banner -->
  <HeroBanner
    compact={true}
    label="ABOUT US"
    title="關於我們"
    subtitle="認識綻顏 BEAUSKIN — 一個為香港女性而生的護膚品牌"
  />

  <!-- Brand Story -->
  <section class="py-16">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <!-- Left: Story -->
        <div>
          <h2 class="font-serif text-3xl text-brand-800 mb-6">品牌故事</h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            綻顏 BEAUSKIN 誕生於 2023 年，由一群熱愛護膚的香港女性共同創立。我們深知香港獨特的潮濕悶熱氣候對肌膚的挑戰，也明白市面上的護膚產品往往未能真正滿足亞洲女性的需求。於是，我們決定親手打造一個屬於香港的護膚品牌。
          </p>
          <p class="text-gray-600 leading-relaxed mb-4">
            我們的使命很簡單：用天然的成分、科學的配方，為每一位亞洲女性帶來安全、有效且價格合理的護膚體驗。我們相信，真正的好護膚品不需要昂貴的價格標籤，而是源於對品質的堅持和對使用者的真心關懷。
          </p>
          <p class="text-gray-600 leading-relaxed">
            「綻顏」之名取自「綻放顏容」之意——我們希望每一位使用 BEAUSKIN 的女性，都能由內而外綻放最真實、最自信的自然之美。
          </p>
        </div>

        <!-- Right: Decorative Brand Box -->
        <div class="bg-brand-100 rounded-2xl p-12 text-center">
          <p class="font-serif text-5xl text-brand-700 mb-2">綻顏</p>
          <p class="text-brand-600 text-lg tracking-[0.2em] uppercase">BEAUSKIN</p>
          <p class="text-brand-500 mt-4 font-serif text-xl">綻放你的自然美</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Brand Values -->
  <section class="py-16 bg-brand-50">
    <div class="max-w-6xl mx-auto px-4">
      <SectionHeader label="OUR VALUES" title="品牌價值" />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Clean Beauty -->
        <div class="text-center">
          <div class="w-16 h-16 rounded-full bg-sage-50 flex items-center justify-center mx-auto mb-5">
            <svg class="w-8 h-8 text-sage-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" />
            </svg>
          </div>
          <h3 class="font-serif text-xl text-brand-800 mb-3">純淨美妝</h3>
          <p class="text-sm text-gray-600 uppercase tracking-wider mb-3">Clean Beauty</p>
          <p class="text-gray-600 leading-relaxed">
            我們堅持使用 90% 以上天然成分，拒絕有害化學添加物，每款產品均通過嚴格的安全測試，讓你安心使用。
          </p>
        </div>

        <!-- Asian R&D -->
        <div class="text-center">
          <div class="w-16 h-16 rounded-full bg-brand-50 flex items-center justify-center mx-auto mb-5">
            <svg class="w-8 h-8 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
            </svg>
          </div>
          <h3 class="font-serif text-xl text-brand-800 mb-3">亞洲研發</h3>
          <p class="text-sm text-gray-600 uppercase tracking-wider mb-3">Asian R&D</p>
          <p class="text-gray-600 leading-relaxed">
            與韓國頂尖皮膚科實驗室合作，結合亞洲肌膚研究最新成果，專為亞洲女性膚質研發高效護膚配方。
          </p>
        </div>

        <!-- Eco Commitment -->
        <div class="text-center">
          <div class="w-16 h-16 rounded-full bg-emerald-50 flex items-center justify-center mx-auto mb-5">
            <svg class="w-8 h-8 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12.75 3.03v.568c0 .334.148.65.405.864l1.068.89c.442.369.535 1.01.216 1.49l-.51.766a2.25 2.25 0 01-1.161.886l-.143.048a1.107 1.107 0 00-.57 1.664c.369.555.169 1.307-.427 1.605L9 13.125l.423 1.059a.956.956 0 01-1.652.928l-.679-.906a1.125 1.125 0 00-1.906.172L4.5 15.75l-.612.153M12.75 3.031a9 9 0 00-8.862 12.872M12.75 3.031a9 9 0 016.69 14.036m0 0l-.177-.529A2.25 2.25 0 0017.128 15H16.5l-.324-.324a1.453 1.453 0 00-2.328.377l-.036.073a1.586 1.586 0 01-.982.816l-.99.282c-.55.157-.894.702-.8 1.267l.073.438c.08.474.49.821.97.821.846 0 1.598.542 1.865 1.345l.215.643m5.276-3.67a9.012 9.012 0 01-5.276 3.67" />
            </svg>
          </div>
          <h3 class="font-serif text-xl text-brand-800 mb-3">環保承諾</h3>
          <p class="text-sm text-gray-600 uppercase tracking-wider mb-3">Eco Commitment</p>
          <p class="text-gray-600 leading-relaxed">
            全面採用可回收包裝材料，零動物測試，積極減少碳足跡，以實際行動守護我們的地球。
          </p>
        </div>

        <!-- Community -->
        <div class="text-center">
          <div class="w-16 h-16 rounded-full bg-rose-50 flex items-center justify-center mx-auto mb-5">
            <svg class="w-8 h-8 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
            </svg>
          </div>
          <h3 class="font-serif text-xl text-brand-800 mb-3">社區共融</h3>
          <p class="text-sm text-gray-600 uppercase tracking-wider mb-3">Community</p>
          <p class="text-gray-600 leading-relaxed">
            我們定期舉辦護膚工作坊和社區活動，與香港女性一起分享美妝知識，建立一個互相支持的美麗社區。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Milestones Timeline -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4">
      <SectionHeader label="MILESTONES" title="品牌里程" />
      <div class="relative">
        <!-- Vertical connecting line -->
        <div class="absolute left-[59px] md:left-1/2 top-0 bottom-0 w-px bg-brand-200 -translate-x-1/2"></div>

        <!-- Timeline entries -->
        {[
          {
            year: '2023',
            text: '品牌創立，推出首 3 款護膚產品，正式進入香港護膚市場',
          },
          {
            year: '2024',
            text: '獲提名 HKTDC「香港品牌大獎」，品牌知名度持續提升',
          },
          {
            year: '2025',
            text: '產品線擴展至 6 款，涵蓋護膚、彩妝、身體護理三大系列',
          },
          {
            year: '2026',
            text: '官方網店正式上線，全港免費送貨，開啟品牌全新篇章',
          },
        ].map((milestone) => (
          <div class="relative flex items-start mb-12 last:mb-0">
            <!-- Mobile layout: year left, dot, text right -->
            <!-- Desktop layout: alternating -->
            <div class="flex items-start w-full">
              <!-- Year (mobile: left, desktop: alternating) -->
              <div class="md:w-1/2 md:text-right md:pr-12 shrink-0 w-16">
                <span class="font-serif text-2xl text-brand-700 md:font-serif md:text-3xl">
                  {milestone.year}
                </span>
              </div>

              <!-- Dot -->
              <div class="absolute left-[52px] md:left-1/2 md:-translate-x-1/2 w-4 h-4 rounded-full bg-brand-600 border-4 border-brand-100 top-1"></div>

              <!-- Description -->
              <div class="md:w-1/2 md:pl-12 ml-6 md:ml-0">
                <p class="text-gray-600 leading-relaxed">{milestone.text}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
