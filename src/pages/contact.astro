---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBanner from '../components/HeroBanner.astro';
---

<BaseLayout title="聯繫我們 | 綻顏 BEAUSKIN" description="歡迎隨時與我們聯繫，我們很樂意為你提供幫助">
  <HeroBanner
    label="CONTACT US"
    title="聯繫我們"
    subtitle="歡迎隨時與我們聯繫，我們很樂意為你提供幫助"
    compact
  />

  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-2 gap-12">
      <!-- Left column: Info cards -->
      <div class="flex flex-col gap-4">
        <!-- Address -->
        <div class="bg-brand-50 rounded-xl p-4 flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-brand-700 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <h3 class="font-medium text-brand-800">公司地址</h3>
            <p class="text-gray-600 text-sm mt-1">香港九龍旺角彌敦道610號荷李活商業中心1318室</p>
          </div>
        </div>

        <!-- Phone -->
        <div class="bg-brand-50 rounded-xl p-4 flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-brand-700 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <div>
            <h3 class="font-medium text-brand-800">客戶服務熱線</h3>
            <p class="text-gray-600 text-sm mt-1">+852 3123 4567</p>
          </div>
        </div>

        <!-- WhatsApp -->
        <div class="bg-brand-50 rounded-xl p-4 flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-brand-700 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
          </div>
          <div>
            <h3 class="font-medium text-brand-800">WhatsApp</h3>
            <p class="text-gray-600 text-sm mt-1">+852 9123 4567</p>
          </div>
        </div>

        <!-- Email -->
        <div class="bg-brand-50 rounded-xl p-4 flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-brand-700 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <h3 class="font-medium text-brand-800">電郵</h3>
            <p class="text-gray-600 text-sm mt-1">info@beauskin.com.hk</p>
          </div>
        </div>

        <!-- Business hours -->
        <div class="bg-brand-50 rounded-xl p-4 flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-brand-700 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h3 class="font-medium text-brand-800">營業時間</h3>
            <p class="text-gray-600 text-sm mt-1">星期一至六 11:00-20:00<br />星期日及公眾假期休息</p>
          </div>
        </div>
      </div>

      <!-- Right column: Contact form -->
      <div>
        <form action="/api/contact" method="POST" class="flex flex-col gap-4">
          <div>
            <label for="name" class="block text-sm font-medium text-brand-800 mb-1">姓名</label>
            <input type="text" id="name" name="name" required
              class="w-full px-4 py-2.5 rounded-lg border border-gray-200 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-brand-800 mb-1">電郵</label>
            <input type="email" id="email" name="email" required
              class="w-full px-4 py-2.5 rounded-lg border border-gray-200 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition" />
          </div>
          <div>
            <label for="phone" class="block text-sm font-medium text-brand-800 mb-1">電話</label>
            <input type="tel" id="phone" name="phone"
              class="w-full px-4 py-2.5 rounded-lg border border-gray-200 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition" />
          </div>
          <div>
            <label for="type" class="block text-sm font-medium text-brand-800 mb-1">查詢類型</label>
            <select id="type" name="type"
              class="w-full px-4 py-2.5 rounded-lg border border-gray-200 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition bg-white">
              <option value="產品查詢">產品查詢</option>
              <option value="訂單問題">訂單問題</option>
              <option value="退換貨">退換貨</option>
              <option value="合作提案">合作提案</option>
              <option value="其他">其他</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-brand-800 mb-1">訊息內容</label>
            <textarea id="message" name="message" rows="5" required
              class="w-full px-4 py-2.5 rounded-lg border border-gray-200 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition resize-none"></textarea>
          </div>
          <button type="submit"
            class="w-full bg-brand-700 text-white py-3 rounded-full hover:bg-brand-800 transition font-medium">
            提交查詢
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- Map placeholder -->
  <section class="py-12 bg-brand-50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="bg-brand-200 rounded-2xl h-80 flex flex-col items-center justify-center gap-3">
        <svg class="w-10 h-10 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <p class="text-brand-700 font-medium">香港九龍旺角彌敦道610號荷李活商業中心1318室</p>
        <p class="text-brand-500 text-sm">Google Maps</p>
      </div>
    </div>
  </section>
</BaseLayout>
