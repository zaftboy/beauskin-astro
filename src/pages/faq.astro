---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBanner from '../components/HeroBanner.astro';
import faqData from '../data/faq.json';
---

<BaseLayout title="常見問題 | 綻顏 BEAUSKIN" description="BEAUSKIN 常見問題解答，找不到答案？歡迎隨時聯繫我們的客服團隊。">
  <HeroBanner
    label="FAQ"
    title="常見問題"
    subtitle="找不到答案？歡迎隨時聯繫我們的客服團隊。"
    compact
  />

  <section class="py-12">
    <div class="max-w-3xl mx-auto px-4">
      {faqData.map(item => (
        <div class="faq-item border-b border-gray-200">
          <button class="faq-q flex justify-between items-center w-full py-5 text-left">
            <span class="font-medium text-brand-800 pr-4">{item.question}</span>
            <svg class="faq-arrow w-5 h-5 text-brand-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-answer">
            <p class="text-gray-600 pb-5">{item.answer}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-brand-800">
    <div class="max-w-3xl mx-auto px-4 text-center text-white">
      <h2 class="font-serif text-3xl md:text-4xl">還有其他問題？</h2>
      <p class="mt-4 text-white/80">我們的客服團隊隨時為您提供幫助</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-8">
        <a href="/contact"
          class="inline-block bg-white text-brand-800 px-8 py-3 rounded-full font-medium hover:bg-gray-100 transition">
          聯繫我們
        </a>
        <a href="https://wa.me/85291234567" target="_blank" rel="noopener noreferrer"
          class="inline-block border border-white text-white px-8 py-3 rounded-full font-medium hover:bg-white/10 transition">
          WhatsApp 咨詢
        </a>
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll('.faq-item').forEach(item => {
      const btn = item.querySelector('.faq-q');
      btn?.addEventListener('click', () => {
        document.querySelectorAll('.faq-item.active').forEach(other => {
          if (other !== item) other.classList.remove('active');
        });
        item.classList.toggle('active');
      });
    });
  </script>
</BaseLayout>
