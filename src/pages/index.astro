---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBanner from '../components/HeroBanner.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProductCard from '../components/ProductCard.astro';
import BlogCard from '../components/BlogCard.astro';
import StarRating from '../components/StarRating.astro';
import { getCollection } from 'astro:content';
import reviews from '../data/reviews.json';

const allProducts = await getCollection('products');
const featuredProducts = allProducts
  .sort((a, b) => a.data.name.localeCompare(b.data.name, 'zh-Hant'))
  .slice(0, 3);

const allBlogPosts = await getCollection('blog');
const latestPosts = allBlogPosts
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);

function parsePrice(priceStr: string): number {
  return parseFloat(priceStr.replace(/[^0-9.]/g, ''));
}

function getSlug(id: string): string {
  return id.replace(/\.md$/, '');
}
---

<BaseLayout
  title="綻顏 BEAUSKIN — 香港本土天然護膚品牌"
  description="香港本土研發護膚品牌，天然成分 × 科學配方，為亞洲肌膚量身打造。探索 BEAUSKIN 的護膚、彩妝及身體護理產品。"
>

  <!-- Hero Banner -->
  <HeroBanner
    compact={false}
    backgroundImage="/images/hero-banner.png"
    label="NATURAL BEAUTY FROM HONG KONG"
    title="綻放你的自然美"
    subtitle="香港本土研發護膚品牌，天然成分 × 科學配方，為亞洲肌膚量身打造"
  >
    <div slot="cta" class="flex flex-wrap gap-4 mt-8">
      <a
        href="/products"
        class="inline-block px-8 py-3 rounded-full bg-brand-700 text-white font-medium hover:bg-brand-800 transition-colors"
      >
        瀏覽全部產品
      </a>
      <a
        href="/about"
        class="inline-block px-8 py-3 rounded-full bg-white/20 border border-white/30 backdrop-blur-sm text-white font-medium hover:bg-white/30 transition-colors"
      >
        了解品牌故事
      </a>
    </div>
  </HeroBanner>

  <!-- Featured Products -->
  <section class="bg-brand-50 py-20">
    <div class="max-w-6xl mx-auto px-4">
      <SectionHeader label="FEATURED PRODUCTS" title="明星產品" />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {featuredProducts.map((product) => (
          <ProductCard
            name={product.data.name}
            slug={getSlug(product.id)}
            price={parsePrice(product.data.price)}
            shortDesc={product.data.shortDesc}
            image={product.data.image}
            tags={product.data.tags}
          />
        ))}
      </div>
      <div class="text-center mt-12">
        <a
          href="/products"
          class="inline-block text-brand-700 font-medium hover:text-brand-800 transition-colors"
        >
          查看全部產品 &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Brand Values -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <SectionHeader label="WHY BEAUSKIN" title="品牌理念" />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Natural Ingredients -->
        <div class="rounded-2xl border border-gray-100 p-8">
          <div class="w-14 h-14 rounded-full bg-sage-50 flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-sage-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
            </svg>
          </div>
          <h3 class="font-serif text-xl text-brand-800 mb-3">90%+ 天然成分</h3>
          <p class="text-gray-600 leading-relaxed">我們堅持使用高濃度天然成分，每款產品均通過嚴格篩選，確保成分安全有效。拒絕有害化學物質，讓肌膚享受最純淨的呵護。</p>
        </div>

        <!-- Scientific R&D -->
        <div class="rounded-2xl border border-gray-100 p-8">
          <div class="w-14 h-14 rounded-full bg-brand-50 flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
            </svg>
          </div>
          <h3 class="font-serif text-xl text-brand-800 mb-3">韓國皮膚科實驗室</h3>
          <p class="text-gray-600 leading-relaxed">與韓國頂尖皮膚科實驗室合作研發，將尖端護膚科技與天然精華完美結合，每一款產品都經過嚴格的臨床測試驗證。</p>
        </div>

        <!-- HK Formulation -->
        <div class="rounded-2xl border border-gray-100 p-8">
          <div class="w-14 h-14 rounded-full bg-rose-50 flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
          </div>
          <h3 class="font-serif text-xl text-brand-800 mb-3">香港專屬配方</h3>
          <p class="text-gray-600 leading-relaxed">專為香港潮濕悶熱的亞熱帶氣候量身打造，輕薄不黏膩的質地，讓你在任何季節都能保持清爽舒適的完美膚況。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog Preview -->
  <section class="bg-brand-50 py-20">
    <div class="max-w-6xl mx-auto px-4">
      <SectionHeader label="BEAUTY TIPS" title="美妝知識" />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {latestPosts.map((post) => (
          <BlogCard
            title={post.data.title}
            slug={getSlug(post.id)}
            date={post.data.date}
            category={post.data.category}
            excerpt={post.data.excerpt}
          />
        ))}
      </div>
      <div class="text-center mt-12">
        <a
          href="/blog"
          class="inline-block text-brand-700 font-medium hover:text-brand-800 transition-colors"
        >
          查看全部文章 &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Customer Reviews -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <SectionHeader label="TESTIMONIALS" title="顧客真實評價" />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {reviews.map((review) => (
          <div class="rounded-2xl border border-gray-100 p-8">
            <StarRating rating={review.rating} />
            <p class="text-gray-600 italic mt-4 leading-relaxed">「{review.review}」</p>
            <div class="flex items-center gap-3 mt-6">
              <div class="w-10 h-10 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center font-medium">
                {review.initial}
              </div>
              <div>
                <p class="font-medium text-brand-800">{review.name}</p>
                <p class="text-sm text-gray-500">購買了 {review.product}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="py-20 bg-brand-800">
    <div class="max-w-2xl mx-auto px-4 text-center text-white">
      <h2 class="font-serif text-3xl md:text-4xl">訂閱我們，獲取最新美妝資訊</h2>
      <p class="text-white/70 mt-4 leading-relaxed">
        訂閱 BEAUSKIN 電郵通訊，率先獲得新產品資訊、護膚技巧及專屬優惠。
      </p>
      <form class="flex flex-col sm:flex-row gap-3 mt-8 justify-center">
        <input
          type="email"
          placeholder="請輸入你的電郵地址"
          class="flex-1 max-w-sm px-6 py-3 rounded-full bg-white/10 border border-white/20 text-white placeholder-white/50 focus:outline-none focus:border-white/50"
        />
        <button
          type="submit"
          class="px-8 py-3 rounded-full bg-white text-brand-800 font-medium hover:bg-white/90 transition-colors"
        >
          立即訂閱
        </button>
      </form>
    </div>
  </section>

</BaseLayout>
